# Replace with your computer's Wi-Fi IPv4. Phone must use the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_WIFI_IP:3001/api
# Android emulator: http://10.0.2.2:3001/api
# Production: https://your-backend-domain/api

# Public website used in community share links
EXPO_PUBLIC_WEB_URL=https://decoho-fe.vercel.app

# Enable only after backend bank details, payment credentials, signed callbacks
# and payment-status updates are configured and verified end to end.
EXPO_PUBLIC_ENABLE_ONLINE_PAYMENTS=false

# Optional Google native sign-in (requires a development/production build).
# WEB client ID must match backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
