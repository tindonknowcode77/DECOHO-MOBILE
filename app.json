{
  "expo": {
    "name": "DECOHO",
    "slug": "decoho-mobile",
    "scheme": "decoho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/decoho-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.decoho.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.decoho.mobile",
      "versionCode": 1,
      "icon": "./assets/decoho-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F7F3EC"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/decoho-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép DECOHO chọn ảnh phòng và chia sẻ không gian của bạn.",
          "cameraPermission": "Cho phép DECOHO chụp ảnh để nhận diện nội thất.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "privacyPolicyUrl": "https://decoho-fe.vercel.app/privacy",
      "accountDeletionUrl": "https://decoho-fe.vercel.app/privacy#delete-account",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3df1d541-7305-40f6-a671-7af8b00f0372"
      }
    }
  }
}
